ADMIN_PASSWORD=replace-with-a-long-unique-password
APP_ORIGIN=
AUTH_SECRET=replace-with-a-random-secret-of-at-least-24-characters
CRON_SECRET=replace-with-another-random-secret-at-least-24-characters
STUDENT_EMAIL_DOMAINS=student.xjtlu.edu.cn
# Real email verification; production ignores the local developer option.
AUTH_DELIVERY=email
SMTP_URL=
SMTP_FROM=
# PostgreSQL for multiple instances. Keep credentials outside Git.
DATABASE_URL=
# Local SQLite uses Node.js 24 and a persistent data/private directory.
ALLOW_LOCAL_DATABASE=false
DATA_DIRECTORY=
# Explicit, one-time imports only. Normal production should start empty.
MIGRATE_LEGACY=false
SEED_DEMO=false
